# GENERATED by scripts/sync-common.sh from terraform/_common_k8s -- edit the source, not this copy.
#
# Shared by folders that talk to the Kubernetes API (helm releases, network policies). The kubernetes/helm provider PINS are added to versions.tf by sync-common.sh
# (Terraform allows only ONE required_providers block per module).
#
# HOW AUTH WORKS: the providers do NOT use a static token. At every plan/apply they run
#   aws eks get-token --cluster-name <name> --region <region>
# which signs an STS GetCallerIdentity request with YOUR current AWS credentials; the EKS authenticator validates it and
# maps your IAM principal through the access entry (cluster creator = admin). So: if `aws sts get-caller-identity` works and
# your IP is allowed on the public endpoint, Terraform can reach the cluster.
# GOES WRONG: "Unauthorized" = your principal has no access entry; "i/o timeout" = endpoint CIDR restriction or private-only endpoint.

data "terraform_remote_state" "eks" {
  backend = "s3"

  config = {
    bucket = var.state_bucket
    key    = "${var.environment}/06-eks/terraform.tfstate"
    region = var.region
  }
}

locals {
  eks = data.terraform_remote_state.eks.outputs
}

provider "kubernetes" {
  host                   = local.eks.cluster_endpoint
  cluster_ca_certificate = base64decode(local.eks.cluster_certificate_authority_data)

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", local.eks.cluster_name, "--region", var.region]
  }
}

provider "helm" {
  kubernetes {
    host                   = local.eks.cluster_endpoint
    cluster_ca_certificate = base64decode(local.eks.cluster_certificate_authority_data)

    exec {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = ["eks", "get-token", "--cluster-name", local.eks.cluster_name, "--region", var.region]
    }
  }
}
