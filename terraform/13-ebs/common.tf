# GENERATED by scripts/sync-common.sh from terraform/_common -- edit the source, not this copy.
#
# Variables, naming and tags shared by every folder.
#
# ENVIRONMENTS: dev/stage/prod are supported by changing `environment` (and the state key prefix in
#      scripts/env.sh). All resource names derive from local.name, so two environments never collide.

variable "project" {
  description = "Project short name, used as the prefix of every resource."
  type        = string
  default     = "cloudcart"
}

variable "environment" {
  description = "Environment name (lab, dev, stage, prod)."
  type        = string
  default     = "lab"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,10}$", var.environment))
    error_message = "environment must be 2-11 chars, lowercase letters, digits or hyphens."
  }
}

variable "region" {
  description = "AWS region for all regional resources."
  type        = string
  default     = "us-east-1"
}

variable "owner" {
  description = "Value of the Owner cost-allocation tag."
  type        = string
  default     = "CloudCart"
}

variable "state_bucket" {
  description = "S3 bucket that holds every folder's state (created by 00-bootstrap). Exported as TF_VAR_state_bucket by scripts/env.sh."
  type        = string
}

data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  # e.g. "cloudcart-lab". Also the EKS cluster name.
  name       = "${var.project}-${var.environment}"
  account_id = data.aws_caller_identity.current.account_id
  partition  = data.aws_partition.current.partition

  # Parameter Store path every service publishes its endpoints under (apps read it at startup; see 18-parameter-store).
  ssm_prefix = "/${var.project}/${var.environment}"

  tags = {
    Project     = "CloudCart"
    Environment = var.environment
    ManagedBy   = "Terraform"
    Owner       = var.owner
    Layer       = basename(abspath(path.module))
  }
}
