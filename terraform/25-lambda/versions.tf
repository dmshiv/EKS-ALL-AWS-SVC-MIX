# GENERATED by scripts/sync-common.sh from terraform/_common -- edit the source, not this copy.
#
# WHY: every numbered folder is an independent Terraform root module with its own state file.
#      The boilerplate (Terraform/provider pins, backend type, tags) must be identical everywhere
#      or one folder could silently upgrade the AWS provider while others stay behind.
# BACKEND: `backend "s3" {}` is intentionally EMPTY ("partial configuration"). Bucket, key and region
#      are injected by scripts/tf.sh with -backend-config, so the state key is always "<folder>/terraform.tfstate"
#      and no account-specific value is ever committed.
# LOCKING: use_lockfile=true (passed by tf.sh) uses S3 native conditional writes. The older DynamoDB lock
#      table is deprecated, which is why we need Terraform >= 1.11.
terraform {
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.7"
    }
  }

  backend "s3" {}
}
