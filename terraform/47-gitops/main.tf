# =============================================================================
# 47-gitops : Argo CD (OPTIONAL)
# =============================================================================
#
#   developer --git push--> Git repo (helm/cloudcart + values) <--poll/webhook-- Argo CD (in cluster) --apply--> cluster
#   CI (46-cicd) builds the image and commits the new image tag; Argo CD notices Git changed and syncs.
#
# GITOPS vs CLASSIC CI/CD
#   classic : CI has cluster credentials and runs `helm upgrade` (push). Drift (someone ran kubectl edit) is invisible. Rollback = rerun an old pipeline.
#   GitOps  : Git is the single source of truth; an in-cluster agent PULLS and continuously reconciles. No cluster credentials outside the cluster,
#             manual drift is reverted (selfHeal), every change is a reviewed commit, rollback = `git revert`, audit trail = git log.
# WHAT TERRAFORM OWNS vs WHAT ARGO OWNS: Terraform = AWS infrastructure and platform add-ons. Argo CD = application workloads. Do not manage the same
#   object with both.
#
# ACCESS (no public exposure in the lab):  kubectl -n argocd port-forward svc/argocd-server 8080:443
#   initial admin password: kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d
#   (that Secret is generated by the chart at install; change it and delete the Secret after first login.)
# Then register the app: kubectl apply -f gitops/argocd-application.yaml   (edit repoURL first)
# COST: runs on existing nodes (a few hundred MB RAM); no AWS charges of its own.

# WHY:        Argo CD makes Git the source of truth and reconciles the cluster continuously (pull model).
# DEPENDS:    Depends on a working cluster and nodes; optional (var.enable_argocd).
# GOES WRONG: Helm timeout = pods Pending (no capacity) or image pull blocked; check kubectl -n argocd get pods.
resource "helm_release" "argocd" {
  count = var.enable_argocd ? 1 : 0

  name             = "argocd"
  namespace        = "argocd"
  create_namespace = true
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = var.argocd_chart_version
  timeout          = 600
  wait             = true

  values = [yamlencode({
    configs = {
      params = {
        # TLS is terminated by whatever you put in front (port-forward in the lab); the server speaks plain HTTP inside the cluster.
        "server.insecure" = true
      }
    }
    dex = { enabled = false }
  })]
}
