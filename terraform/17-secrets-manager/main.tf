# =============================================================================
# 17-secrets-manager : database and cache credentials (no passwords in Git, YAML or images)
# =============================================================================
#
#   Terraform generates a random password --> Secrets Manager (encrypted with the data CMK)
#   RDS / ElastiCache are created WITH that value (19, 21)
#   Pod (order-service/worker) --Pod Identity--> secretsmanager:GetSecretValue --> credentials in memory only
#
# WHICH STORE FOR WHAT (interview)
#   Kubernetes Secret  : base64 in etcd (encrypted with our CMK at rest), readable by anyone with `get secret`, copied into pod env/files,
#                        no rotation, no read audit. OK for non-sensitive/bootstrap values only. CloudCart uses none.
#   SSM Parameter Store: hierarchical CONFIG ("/app/env/key"), String or SecureString (KMS), standard tier FREE, no native rotation.
#   Secrets Manager    : SECRETS needing rotation + audit + cross-account sharing; $0.40/secret/month + $0.05/10k API calls.
#
# LAB vs PRODUCTION: the generated password is stored in Terraform STATE (encrypted S3 bucket). PRODUCTION: let RDS manage the master
# password (manage_master_user_password=true, automatic rotation) or rotate with a Lambda, and keep state access tightly restricted.
# We generate it here so the secret NAME is known in advance (IAM policies can reference it) and the folder order stays clean.
#
# DEPENDS ON: 16-kms, 08-pod-identity.  USED BY: 19-rds (password), 21-elasticache (token), the apps (read at startup).
# GOES WRONG: AccessDenied on GetSecretValue = the role lacks secretsmanager:GetSecretValue OR kms:Decrypt on the key (two gates).

# RDS password rules: printable ASCII except / @ " and space. special=false keeps it URL/DSN-safe for every client library.
resource "random_password" "rds" {
  length  = 32
  special = false
}

# WHY:        The Redis auth token is generated by Terraform so no human ever types or commits it.
# DEPENDS:    Consumed by 21-elasticache through the secret.
# GOES WRONG: The value lives in Terraform state (encrypted S3); treat state access as secret access.
resource "random_password" "redis" {
  length  = 40
  special = false
}

# WHAT:   The secret that order-service and worker read. JSON so the app gets username and password together.
# recovery_window 0 (lab): deleting the secret removes it immediately so terraform destroy/apply cycles never hit "scheduled for deletion".
resource "aws_secretsmanager_secret" "rds" {
  name                    = "${local.name}/rds-credentials"
  description             = "CloudCart PostgreSQL master credentials"
  kms_key_id              = local.data_key_arn
  recovery_window_in_days = var.recovery_window_in_days
}

# WHY:        Stores the initial database credentials for the order service; the app reads them at runtime through its IAM role.
# DEPENDS:    Depends on the RDS secret; consumed by 19-rds and the order service.
# GOES WRONG: Rotating the password outside Terraform makes the next plan show a diff: do not re-apply the old value over a rotated one.
resource "aws_secretsmanager_secret_version" "rds" {
  secret_id = aws_secretsmanager_secret.rds.id

  secret_string = jsonencode({
    username = var.db_username
    password = random_password.rds.result
  })
}

# WHY:        Container for the Redis token: encrypted with the CMK and access-controlled by IAM.
# DEPENDS:    Depends on 16-kms; read by the order service.
# GOES WRONG: Deleting with a recovery window of 0 destroys the value immediately.
resource "aws_secretsmanager_secret" "redis" {
  name                    = "${local.name}/redis-auth-token"
  description             = "ElastiCache AUTH token for CloudCart"
  kms_key_id              = local.data_key_arn
  recovery_window_in_days = var.recovery_window_in_days
}

# WHY:        The actual secret value (generated token).
# DEPENDS:    Depends on random_password.redis and the secret.
# GOES WRONG: Rotating without updating ElastiCache auth breaks the app: both must change together.
resource "aws_secretsmanager_secret_version" "redis" {
  secret_id     = aws_secretsmanager_secret.redis.id
  secret_string = jsonencode({ auth_token = random_password.redis.result })
}

# ---------------------------------------------------------------------------------------------
# WHO MAY READ THEM (least privilege per workload)
# ---------------------------------------------------------------------------------------------
# order-service + worker -> the DB secret.   product-service -> the Redis token.   frontend -> nothing.
# kms:Decrypt is constrained with kms:ViaService so the key is usable only through Secrets Manager by these roles.
data "aws_iam_policy_document" "read_rds_secret" {
  statement {
    sid       = "ReadDatabaseCredentials"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.rds.arn]
  }

  statement {
    sid       = "DecryptViaSecretsManager"
    actions   = ["kms:Decrypt"]
    resources = [local.data_key_arn]

    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["secretsmanager.${var.region}.amazonaws.com"]
    }
  }
}

data "aws_iam_policy_document" "read_redis_secret" {
  statement {
    sid       = "ReadRedisAuthToken"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.redis.arn]
  }

  statement {
    sid       = "DecryptViaSecretsManager"
    actions   = ["kms:Decrypt"]
    resources = [local.data_key_arn]

    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["secretsmanager.${var.region}.amazonaws.com"]
    }
  }
}

# WHY:        Grants the order-service role GetSecretValue on ONLY the database secret.
# DEPENDS:    Depends on the order-service role; used by the app at startup.
# GOES WRONG: AccessDenied on GetSecretValue (the 'Secrets Manager' failure test) = missing/mis-scoped policy or missing kms:Decrypt.
resource "aws_iam_role_policy" "rds_secret" {
  for_each = toset(["order-service", "worker"])

  name   = "read-rds-secret"
  role   = local.role_names[each.key]
  policy = data.aws_iam_policy_document.read_rds_secret.json
}

# WHY:        Grants the order-service role read access to the Redis secret only.
# DEPENDS:    Depends on the order-service role.
# GOES WRONG: Over-broad wildcard here would let the service read every secret in the account.
resource "aws_iam_role_policy" "redis_secret" {
  name   = "read-redis-secret"
  role   = local.role_names["product-service"]
  policy = data.aws_iam_policy_document.read_redis_secret.json
}

# The apps learn WHICH secret to read from Parameter Store (the ARN is not secret; the value is).
resource "aws_ssm_parameter" "rds_secret_arn" {
  name  = "${local.ssm_prefix}/rds/secret_arn"
  type  = "String"
  value = aws_secretsmanager_secret.rds.arn
}

# WHY:        Publishes the secret ARN (not the value) so the app/Helm chart can discover it without hard-coding.
# DEPENDS:    Read by deploy scripts; parameter is not sensitive.
# GOES WRONG: Storing the VALUE here instead of the ARN would defeat the purpose of Secrets Manager.
resource "aws_ssm_parameter" "redis_secret_arn" {
  name  = "${local.ssm_prefix}/redis/secret_arn"
  type  = "String"
  value = aws_secretsmanager_secret.redis.arn
}
